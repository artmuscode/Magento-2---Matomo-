<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="artimus_matomo_order_tracking" resource="default" engine="innodb"
           comment="Matomo Order Tracking">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" identity="false"
                comment="Order ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" identity="false"
                comment="Store ID"/>
        <column xsi:type="varchar" name="visitor_id" nullable="true" length="16" comment="Matomo Visitor ID"/>
        <column xsi:type="varchar" name="user_id" nullable="true" length="64" comment="Matomo User ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16" default="pending"
                comment="Send Status"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" identity="false"
                default="0" comment="Send Attempts"/>
        <column xsi:type="text" name="last_error" nullable="true" comment="Last Error"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="sent_at" on_update="false" nullable="true" comment="Sent At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ARTIMUS_MATOMO_ORDER_TRACKING_ORDER_ID">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ARTIMUS_MATOMO_ORDER_TRACKING_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="artimus_matomo_order_tracking" column="order_id" referenceTable="sales_order"
                    referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ARTIMUS_MATOMO_ORDER_TRACKING_STATUS_CREATED_AT" indexType="btree">
            <column name="status"/>
            <column name="created_at"/>
        </index>
    </table>
</schema>
