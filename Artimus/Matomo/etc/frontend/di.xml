<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Artimus\Matomo\Model\PageContextPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <!-- task 006 providers -->
                <item name="product_view" xsi:type="object">Artimus\Matomo\Model\PageContext\ProductViewProvider</item>
                <item name="category_view" xsi:type="object">Artimus\Matomo\Model\PageContext\CategoryViewProvider</item>
                <item name="search_result" xsi:type="object">Artimus\Matomo\Model\PageContext\SearchResultProvider</item>
                <!-- task 009 providers -->
                <item name="checkout" xsi:type="object">Artimus\Matomo\Model\PageContext\CheckoutPageProvider</item>
            </argument>
        </arguments>
    </type>
    <type name="Artimus\Matomo\ViewModel\TrackerConfig">
        <arguments>
            <argument name="jsComponents" xsi:type="array">
                <!-- task 007 jsComponents -->
                <item name="Artimus_Matomo/js/cart-tracker" xsi:type="array"/>
                <!-- task 008 jsComponents -->
                <item name="Artimus_Matomo/js/user-id" xsi:type="array"/>
            </argument>
        </arguments>
    </type>
    <!-- task 008 sectionSourceMap -->
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="matomo" xsi:type="string">Artimus\Matomo\CustomerData\MatomoSection</item>
            </argument>
        </arguments>
    </type>
</config>
