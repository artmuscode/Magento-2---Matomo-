{
    "name": "artimus/module-matomo",
    "description": "Tracks the customer journey (homepage, category/search, product, cart, checkout, order) in Matomo via the JS tracker and the Matomo PHP SDK.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "proprietary",
    "require": {
        "php": "~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-store": "101.1.*",
        "magento/module-config": "101.2.*",
        "magento/module-cookie": "100.4.*",
        "magento/module-customer": "103.0.*",
        "magento/module-checkout": "100.4.*",
        "magento/module-sales": "103.0.*",
        "magento/module-catalog": "104.0.*",
        "magento/module-catalog-search": "102.0.*",
        "magento/module-csp": "100.4.*",
        "magento/module-message-queue": "100.4.*",
        "magento/module-mysql-mq": "100.4.*",
        "matomo/matomo-php-tracker": "^4.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Artimus\\Matomo\\": ""
        }
    }
}
